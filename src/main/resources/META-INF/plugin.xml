<idea-plugin>
    <id>local.terminal.ctrlspace.conpty</id>
    <name>Terminal Ctrl+Space (ConPTY)</name>
    <vendor>Local build</vendor>
    <description>Preserves Ctrl+Space in focused local Windows ConPTY terminals. Enable the Windows ConPTY profile in Settings. Does not change Nushell bindings. Based on MIT Terminal Kitty Keys.</description>
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>
    <actions>
        <action id="TerminalCtrlSpace.Send" class="com.github.thewoolleyman.jetbrains.terminalkittykeys.SendControlSpaceAction" text="Send Ctrl+Space to Windows Terminal" description="Send Win32 Space+CONTROL to the focused ConPTY">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl SPACE"/>
        </action>
    </actions>
    <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
        <allowedActionsProvider implementation="com.github.thewoolleyman.jetbrains.terminalkittykeys.ControlSpaceAllowedActionsProvider"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable id="terminal.ctrlspace" displayName="Terminal Ctrl+Space (ConPTY)" instance="com.github.thewoolleyman.jetbrains.terminalkittykeys.CtrlSpaceConfigurable"/>
    </extensions>
</idea-plugin>
